# Zendesk
ZENDESK_SUBDOMAIN=your-company        # from https://your-company.zendesk.com
ZENDESK_EMAIL=you@company.com
ZENDESK_API_TOKEN=your_api_token_here

# Vector DB (fill in once you have connection details from your coworker)
VECTOR_DB_PROVIDER=mock               # mock | pinecone | qdrant | weaviate | pgvector | http | lancedb
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
VECTOR_DB_INDEX=zendesk_history

# lancedb provider: local embedded store, extracted from coworker's export
# (AES-encrypted zip — password needed to extract, see README)
VECTOR_DB_PATH=./data/rag-store/store
